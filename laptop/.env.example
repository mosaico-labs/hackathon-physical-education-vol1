# Copy of this file: .env (created by `just setup`). Fill it in.

# The ssh name of your cloud machine (the `Host` you added to ~/.ssh/config, see README).
CLOUD_HOST=hackathon
# Folder of the cloud project on the cloud machine, relative to its home folder.
CLOUD_DIR=hackathon-physical-education-vol1/cloud

# Arms and cameras: find the values with `just find-port` and `just find-cameras`.
FOLLOWER_PORT=/dev/ttyACM0
LEADER_PORT=/dev/ttyACM1
FOLLOWER_ID=follower
LEADER_ID=leader
CAMERAS='{ front: {type: opencv, index_or_path: 0, width: 640, height: 480, fps: 30} }'
