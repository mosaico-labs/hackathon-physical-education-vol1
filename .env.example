# Copy of this file: .env (created by `just local-setup` / `just cloud-setup`). Fill it in.

# Your team name. It goes in front of everything you send to Mosaico, so pick something unique.
TEAM=change-me

# ---- laptop ---------------------------------------------------------------
# The ssh name of your cloud machine (the `Host` you added to ~/.ssh/config, see README).
CLOUD_HOST=hackathon
# Folder of this repo on the cloud machine, relative to its home folder.
CLOUD_DIR=hackathon-physical-education-vol1

# Arms and cameras: find the values with `just find-port` and `just find-cameras`.
FOLLOWER_PORT=/dev/ttyACM0
LEADER_PORT=/dev/ttyACM1
FOLLOWER_ID=follower
LEADER_ID=leader
CAMERAS='{ front: {type: opencv, index_or_path: 0, width: 640, height: 480, fps: 30} }'

# ---- cloud machine -------------------------------------------------------
# TODO: replace with the Mosaico address given by the organisers.
MOSAICO_HOST=mosaico.hackathon.internal
MOSAICO_PORT=6726
MOSAICO_SDK_PATH=/home/ubuntu/workspace/mosaico/mosaico-sdk-py
